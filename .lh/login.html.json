            "content": "<!DOCTYPE html>\r\n<html lang=\"th\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Login - เว็บไซต์สอนเขียนโปรแกรม</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <script src=\"login.js\" defer></script>\r\n</head>\r\n<body data-sidebar=\"/components/empty.html\" class=\"login-page\">\r\n\r\n    <!-- Header -->\r\n    <div id=\"header-placeholder\"></div>\r\n\r\n    <!-- Sidebar -->\r\n    <div id=\"sidebar-placeholder\"></div> \r\n\r\n    <!-- Content -->\r\n    <main id=\"main-content\">\r\n        <h1>เข้าสู่ระบบ</h1>\r\n        <form id=\"login-form\">\r\n            <label for=\"username\">ชื่อผู้ใช้</label><br>\r\n            <input type=\"text\" id=\"username\" name=\"username\" required><br><br>\r\n\r\n            <label for=\"password\">รหัสผ่าน</label><br>\r\n            <input type=\"password\" id=\"password\" name=\"password\" required><br><br>\r\n\r\n            <button type=\"submit\">เข้าสู่ระบบ</button>\r\n        </form>\r\n        <p id=\"login-error\" style=\"color: red; display: none;\">ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง</p>\r\n    </main>\r\n\r\n    <!-- Footer -->\r\n    <div id=\"footer-placeholder\"></div>\r\n\r\n</body>\r\n</html>\r\n"
