            "date": 1765273849460,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"th\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>ยืนยัน OTP - เว็บไซต์สอนเขียนโปรแกรม</title>\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n    <script src=\"script.js\" defer></script>\r\n</head>\r\n<body data-sidebar=\"/components/empty.html\">\r\n\r\n    <!-- Header -->\r\n    <div id=\"header-placeholder\"></div>\r\n\r\n    <!-- Sidebar -->\r\n    <div id=\"sidebar-placeholder\"></div> \r\n\r\n    <!-- Content -->\r\n    <main id=\"main-content\">\r\n        <h1>ยืนยัน OTP</h1>\r\n        <p>กรุณากรอกรหัส OTP ที่คุณได้รับทางอีเมล</p>\r\n\r\n        <input type=\"text\" id=\"otp\" placeholder=\"กรอก OTP\">\r\n        <button id=\"verify-btn\">ยืนยัน</button>\r\n        <p id=\"message\" style=\"color:red;\"></p>\r\n\r\n        <p>กลับไป <a href=\"login.html\">เข้าสู่ระบบ</a></p>\r\n\r\n        <script>\r\n            document.getElementById(\"verify-btn\").addEventListener(\"click\", async () => {\r\n                const otp = document.getElementById(\"otp\").value;\r\n                const res = await fetch(\"/verify-otp\", {\r\n                    method: \"POST\",\r\n                    headers: { \"Content-Type\": \"application/json\" },\r\n                    body: JSON.stringify({ otp })\r\n                });\r\n                const data = await res.json();\r\n                document.getElementById(\"message\").textContent = data.message;\r\n\r\n                if(data.success) {\r\n                    // ถ้า OTP ถูกต้อง อาจ redirect ไปหน้าอื่น\r\n                    setTimeout(() => { window.location.href = \"/login.html\"; }, 2000);\r\n                }\r\n            });\r\n        </script>\r\n    </main>\r\n\r\n    <!-- Footer -->\r\n    <div id=\"footer-placeholder\"></div>\r\n\r\n</body>\r\n</html>\r\n"
