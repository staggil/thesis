= \"/login.html\", 1500); // ไป login หลัง OTP ถูกต้อง\r\n+    } else {\r\n+        errEl.textContent = data.message;\r\n+        errEl.style.display = \"block\";\r\n+        successEl.style.display = \"none\";\r\n+    }\r\n+});\r\n+</script>\r\n+</body>\r\n+</html>\r\n"
